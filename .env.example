# Required. API key for the LLM provider (Mistral by default) -- never
# commit a real value here.
LLM_API_KEY=

# Optional. Comma-separated list of allowed frontend origins for CORS,
# e.g. https://myapp.vercel.app,https://myapp-git-main-myteam.vercel.app
# Defaults to "*" (any origin) if unset.
CORS_ORIGINS=*

# Optional overrides -- see app/config.py for defaults.
# MODEL_PARSE=ministral-8b-latest
# MODEL_NARRATE=ministral-3b-latest
# MODEL_FALLBACK=ministral-3b-latest
# LLM_BASE_URL=https://api.mistral.ai/v1

# Local dev only -- Railway injects this itself in production.
# PORT=7860
